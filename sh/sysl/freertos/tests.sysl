module sh.sysl.freertos

@tests
@include("FreeRTOS.h")
@include("task.h")

// The binding's own tests, run by `sysl test .` against a kernel you have built.
//
// **This file is the shared half; the tests themselves sit beside the source file each one is about**
// -- `queue_tests.sysl` next to `queue.sysl`, and so on for tasks, semaphores, timers, event groups,
// stream buffers, queue sets and the interrupt half. What is left here is the argument they all rest
// on, the two or three helpers more than one of them needs, and the pair that measures the isolation
// the rest of them take for granted.
//
// **Not one of these starts the scheduler, and that is the whole design of the suite.** `start` never
// returns, so a test that called it would take the runner with it -- and a test that created tasks and
// let them run would be timing-dependent besides. What makes a real suite possible anyway is that a
// FreeRTOS object is fully working *before* the scheduler runs: `xQueueGenericCreate`, every
// non-blocking send and receive, the counts, the semaphores, `xTaskCreate` and the whole of the task
// introspection surface all operate on the kernel's own data structures and none of them needs a
// context switch. A wait of `0` never blocks, which is what keeps every call here bounded.
//
// So what is checked is exactly what a binding can get wrong: that a symbol resolves, that an argument
// is in the right position, that a `c const` measured the number the header meant, and that the
// discriminator hidden inside a macro was the right one. **Whether the scheduler schedules is
// FreeRTOS's business, and it has its own tests for that.** The README's example is where preemption
// is actually exercised, and it is a program rather than a test for the reason above.
//
// **Each test gets a kernel of its own** -- nothing one leaves behind is visible to the next, which
// `a_test_does_not_see_what_an_earlier_one_left_behind` below measures rather than assumes. That is
// what lets a test create the timer daemon, or fill its command queue, without arranging anything for
// the tests after it.
//
// It is still worth deleting what a test creates, and every one does: a test that leaks within its own
// run tells you less than one that ends where it started.
//
// **The helpers below are `private[freertos]` rather than `private` because `private` is file-scoped**
// -- which is the one thing splitting a module across files changes, and it changes it silently: a
// file-private helper simply stops being visible to the tests that were using it.

// A task body for tests that need a real task to look at. It is never scheduled -- nothing here starts
// the scheduler -- so what it does is irrelevant; what matters is that it is a `TaskFunction_t` a
// create call will accept.
private[freertos] idle_body(arg: *u8) = delay(forever)

// The state a task or a timer is handed in the tests that pass one, and the reason it is a named
// struct rather than the `u32` beside it: `task`, `task_static`, `timer` and `timer_static` are
// generic in what they carry, so a *typed* address is what a caller now writes and the `void *` is
// what the kernel gets. A test passing `marker_ptr()` exercises the shape those calls used to have.
//
// It crosses because it holds no counts at all. `@crossing` walks whatever is here at every one of
// those calls, and a `&Carried` field would be refused with the `&sync Carried` it should have been --
// so the accepting half of that rule is pinned by these files compiling, and the refusing half is a
// diagnostic no `@test` can assert.
private[freertos] struct Carried
    ticks: usize
    ok: bool

private[freertos] var probe_carried: Carried = Carried(0, false)

// Its address as the untyped pointer the kernel hands back, for the same reason `marker_ptr` exists:
// `ptr_cast` takes its target type from where its result is read into, and a comparison says nothing
// about that.
private[freertos] carried_ptr() -> *u8 = ptr_cast(&probe_carried)

// A task body that reads a typed argument rather than a byte pointer, which is what `task`'s `T` is
// for. Never scheduled, exactly like `idle_body`.
private[freertos] carried_body(r: *Carried) = delay(forever)

// -- What one test can see of another ---------------------------------------------------------------

@test
a_test_leaves_something_behind_for_the_next_one_to_look_for() =
    // These two are a pair and only mean anything together. The claim being measured is the one the
    // header of this file rests on -- that a test cannot see what an earlier one did -- and it is
    // measured rather than assumed because getting it wrong the other way costs a session: a kernel
    // assertion about a null queue, fired from a test that had every reason to believe the timer
    // service already existed because a test above it had created one.
    isolation_probe = 42

    assert(isolation_probe == 42, "module storage is writable, so the next test's reading means something")

@test
a_test_does_not_see_what_an_earlier_one_left_behind() =
    assert(isolation_probe == 0,
           "module storage is back at its initial value, so no state carries from one test to the next")

// The pair above, and nothing else, writes this.
private var isolation_probe: usize = 0

// Something with an address, for the tests that pass an opaque pointer through the kernel and want to
// recognise it coming back -- a timer's id, and a callback's context. Module storage because a
// callback has no captures, which is the same constraint a task body is under and the reason a timer
// carries an id at all.
private[freertos] var probe_marker: u32 = 0

// The marker's address as the untyped pointer both of those are, said once because `ptr_cast` takes
// its target type from where the result is read into and a comparison says nothing about that.
private[freertos] marker_ptr() -> *u8 = ptr_cast(&probe_marker)

// How many times a callback has been entered, which is what the two callbacks here record and the only
// thing they do.
private[freertos] var probe_seen: usize = 0

// A timer callback for the tests that create timers. It never runs -- nothing in the suite lets the
// daemon execute -- so what it does is irrelevant; what matters is that it is a shape `xTimerCreate`
// will accept.
private[freertos] probe_tick(handle: *TimerControl) = probe_seen += 1

// -- Why there is nothing of the application's in this file ---------------------------------------
//
// A FreeRTOS kernel demands things of whoever links it: a `configASSERT` handler, and -- under
// `configSUPPORT_STATIC_ALLOCATION` -- the idle and timer tasks' storage through
// `vApplicationGetIdleTaskMemory` and `vApplicationGetTimerTaskMemory`. The test binary is an
// application, so without them the suite does not link, naming `_vAssertCalled` referenced from
// `pvPortMalloc` and saying nothing about what wanted it.
//
// **They are answered by `test-config/FreeRTOSConfig.h` rather than written here, and that is not
// tidiness.** An `@export` is one definition of one symbol, so three `@export`s in the suite would be
// three definitions in every build that keeps them -- and a real application must have its own three.
// A package cannot supply a symbol its consumer is obliged to define.
//
// So the config sets `configKERNEL_PROVIDED_STATIC_MEMORY 1`, which has the kernel define its own
// static storage, and spells `configASSERT` through libc's `assert`. Neither needs a symbol from
// anybody. A real application on a real board will want the hooks -- README.md shows them -- and this
// file is the wrong place to demonstrate that, because a demonstration here is a definition
// everywhere.
