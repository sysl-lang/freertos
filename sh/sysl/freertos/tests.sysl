module sh.sysl.freertos

@tests
@include("FreeRTOS.h")
@include("task.h")

// The binding's own tests, run by `sysl test .` against a kernel you have built.
//
// **Not one of these starts the scheduler, and that is the whole design of this file.** `start` never
// returns, so a test that called it would take the runner with it -- and a test that created tasks and
// let them run would be timing-dependent besides. What makes a real suite possible anyway is that a
// FreeRTOS object is fully working *before* the scheduler runs: `xQueueGenericCreate`, every
// non-blocking send and receive, the counts, the semaphores, `xTaskCreate` and the whole of the task
// introspection surface all operate on the kernel's own data structures and none of them needs a
// context switch. A wait of `0` never blocks, which is what keeps every call here bounded.
//
// So what is checked is exactly what a binding can get wrong: that a symbol resolves, that an argument
// is in the right position, that a `c const` measured the number the header meant, and that the
// discriminator hidden inside a macro was the right one. **Whether the scheduler schedules is
// FreeRTOS's business, and it has its own tests for that.** The README's example is where preemption
// is actually exercised, and it is a program rather than a test for the reason above.
//
// The one thing to be careful of: these run in one process against one kernel, so a test that created
// a task and did not delete it would leave it for every test after. Each one cleans up.

// A task body for tests that need a real task to look at. It is never scheduled -- nothing here starts
// the scheduler -- so what it does is irrelevant; what matters is that it is a `TaskFunction_t` a
// create call will accept.
private idle_body(arg: *u8) = delay(forever)

@test
the_tick_rate_is_what_the_config_said() =
    // Not a tautology: it is the one number the whole file is calibrated against, and a `c const` that
    // silently read a different macro would make every duration below wrong by the same factor.
    assert(tick_rate > 0, "configTICK_RATE_HZ is a positive number of ticks per second")

@test
milliseconds_become_ticks_at_the_configured_rate() =
    assert(ticks(1000) == tick_rate, "a second is however many ticks a second is")
    assert(ticks(0) == 0, "no time is no ticks")

@test
a_duration_shorter_than_a_tick_rounds_to_none() =
    // The kernel's own rounding, towards zero. Worth pinning because the alternative -- rounding up so
    // that a nonzero delay always waits -- is defensible and is *not* what FreeRTOS does, so a caller
    // who needs at least one tick has to say so.
    if tick_rate <= 1000 then
        assert(ticks(1000 / tick_rate - 1) == 0, "less than one tick's worth is no ticks")

@test
the_static_storage_sizes_are_measured_rather_than_guessed() =
    // These come out of the kernel's headers through `c const`. A zero would mean the expression did
    // not measure what it was meant to, and a program would then declare a zero-length array for a
    // control block and hand the kernel a pointer to nothing.
    assert(task_words > 0, "a task control block is some whole number of words")
    assert(queue_words > 0, "a queue control block is some whole number of words")
    assert(semaphore_words > 0, "a semaphore control block is some whole number of words")
    assert(min_stack > 0, "configMINIMAL_STACK_SIZE is a real floor")
    assert(max_priorities > 1, "a scheduler with one priority would have nothing to schedule")

@test
forever_is_the_kernel_s_own_block_forever() =
    // `portMAX_DELAY` is a value the kernel tests for rather than a large number it waits out, so this
    // pins that `c const` read the macro and not, say, a config knob that happened to be nearby.
    assert(forever > tick_rate, "blocking forever is not a duration anybody would write by accident")

// -- Queues -------------------------------------------------------------------------------------

@test
a_queue_reports_what_it_was_created_with() =
    val q = queue(4, sizeof(u32)).expect("a four-slot queue of u32 fits in the test heap")

    assert(q.capacity == 4, "four slots")
    assert(q.item_size == sizeof(u32), "each holding a u32")
    assert(q.waiting == 0, "and nothing in it yet")
    assert(q.spaces == 4, "so all four are free")

    q.delete()

@test
an_item_sent_comes_back_out() =
    val q = queue(4, sizeof(u32)).expect("a four-slot queue of u32 fits in the test heap")

    assert(q.send(7u32, 0), "sending into an empty queue does not wait")
    assert(q.waiting == 1, "and there is one in it")

    var got: u32 = 0

    assert(q.receive(&got, 0), "receiving from a queue holding one does not wait")
    assert(got == 7, "and it is the value that went in")
    assert(q.waiting == 0, "which is no longer in the queue")

    q.delete()

@test
a_queue_is_first_in_first_out_and_the_front_jumps_it() =
    // The two send positions are `queueSEND_TO_BACK` and `queueSEND_TO_FRONT`, which are macros rather
    // than symbols -- so this is the test that the `c const` read the right one of the pair. Reversed,
    // both sends would still succeed and the order would be wrong.
    val q = queue(4, sizeof(u32)).expect("a four-slot queue of u32 fits in the test heap")

    q.send(1u32, 0)
    q.send(2u32, 0)
    q.send_front(99u32, 0)

    var got: u32 = 0

    q.receive(&got, 0)
    assert(got == 99, "the one sent to the front is first")
    q.receive(&got, 0)
    assert(got == 1, "then the rest in the order they were sent")
    q.receive(&got, 0)
    assert(got == 2, "all of it")

    q.delete()

@test
peeking_leaves_the_item_where_it_was() =
    val q = queue(2, sizeof(u32)).expect("a two-slot queue of u32 fits in the test heap")

    q.send(5u32, 0)

    var got: u32 = 0

    assert(q.peek(&got, 0), "peeking at a queue holding one succeeds")
    assert(got == 5, "and reads the item")
    assert(q.waiting == 1, "which is still in the queue")

    q.delete()

@test
a_full_queue_refuses_rather_than_waiting() =
    val q = queue(1, sizeof(u32)).expect("a one-slot queue of u32 fits in the test heap")

    assert(q.send(1u32, 0), "the first send fits")
    assert(!q.send(2u32, 0), "the second has nowhere to go and was told not to wait")
    assert(q.waiting == 1, "and did not overwrite what was there")

    q.delete()

@test
an_empty_queue_answers_nothing_rather_than_waiting() =
    val q = queue(1, sizeof(u32)).expect("a one-slot queue of u32 fits in the test heap")

    var got: u32 = 1

    assert(!q.receive(&got, 0), "there is nothing to receive")
    assert(got == 1, "and the destination was left alone")

    q.delete()

@test
overwrite_replaces_the_item_in_a_one_slot_queue() =
    val q = queue(1, sizeof(u32)).expect("a one-slot queue of u32 fits in the test heap")

    q.send(1u32, 0)
    assert(q.overwrite(2u32), "overwriting a full one-slot queue succeeds")
    assert(q.waiting == 1, "and there is still exactly one item")

    var got: u32 = 0

    q.receive(&got, 0)
    assert(got == 2, "which is the one that overwrote")

    q.delete()

@test
overwrite_is_refused_on_a_queue_with_more_than_one_slot() =
    // `queueOVERWRITE` is only defined for a one-slot queue -- the kernel's own `configASSERT` says so
    // -- so this is refused here rather than passed on to an assertion that may be compiled out.
    val q = queue(2, sizeof(u32)).expect("a two-slot queue of u32 fits in the test heap")

    assert(!q.overwrite(1u32), "overwrite means nothing where there is more than one slot")

    q.delete()

@test
an_item_of_the_wrong_size_is_refused_rather_than_copied() =
    // The check that makes an untyped queue safe to use through generic sends. Without it a `u64` into
    // a queue of `u32` would have the kernel copy four bytes of an eight-byte value, and a `u16` into
    // one of `u32` would have it read two bytes past the caller's variable.
    val q = queue(2, sizeof(u32)).expect("a two-slot queue of u32 fits in the test heap")

    assert(!q.send(7u64, 0), "a u64 is not the size of this queue's slot")
    assert(!q.send(7u16, 0), "nor is a u16")
    assert(q.waiting == 0, "and neither of them went in")

    var wide: u64 = 0

    assert(!q.receive(&wide, 0), "and nothing comes out into the wrong width either")

    q.delete()

@test
a_queue_of_a_struct_copies_the_whole_thing() =
    // A queue copies, which is what makes it the safe way to move a *value* between tasks. A struct is
    // the case that says the copy is the struct rather than a pointer to it.
    val q = queue(2, sizeof(Reading)).expect("a two-slot queue of Reading fits in the test heap")

    assert(q.send(Reading(3, 4000000000u32), 0), "a struct the size of a slot goes in")

    var got = Reading(0, 0)

    assert(q.receive(&got, 0), "and comes back")
    assert(got.channel == 3, "with its first field")
    assert(got.value == 4000000000u32, "and its second, which does not fit in an i32")

    q.delete()

@test
resetting_a_queue_throws_away_what_was_in_it() =
    val q = queue(4, sizeof(u32)).expect("a four-slot queue of u32 fits in the test heap")

    q.send(1u32, 0)
    q.send(2u32, 0)
    q.reset()

    assert(q.waiting == 0, "nothing is left")
    assert(q.spaces == 4, "and every slot is free again")

    q.delete()

@test
a_queue_can_be_made_from_storage_the_caller_owns() =
    // The no-allocator path. `queue_words` is the number this cannot be written without, which is why
    // it is a `c const` and not a constant somebody transcribed.
    var slots: [16]u8 = [0; 16]
    var control: [queue_words]usize = [0; queue_words]

    val q = queue_static(slots[0..<16], control[0..<queue_words], sizeof(u32)).expect("sixteen bytes is four u32 slots")

    assert(q.capacity == 4, "the capacity comes from the storage and the item size")
    assert(q.send(9u32, 0), "and it works exactly as a heap-allocated one does")

    var got: u32 = 0

    q.receive(&got, 0)
    assert(got == 9, "including what comes back out")

    q.delete()

@test
static_storage_too_small_for_a_control_block_is_refused() =
    var slots: [16]u8 = [0; 16]
    var control: [1]usize = [0; 1]

    // One word is not a control block on any port -- `queue_words` is 21 on the POSIX port and 20 on a
    // Cortex-M -- and handing it over would have the kernel write over whatever is next to it.
    assert(queue_static(slots[0..<16], control[0..<1], sizeof(u32)).is_none(),
           "a control block that could not fit is refused rather than written into")

@test
a_zero_item_size_is_refused_rather_than_dividing_by_it() =
    var slots: [16]u8 = [0; 16]
    var control: [queue_words]usize = [0; queue_words]

    assert(queue_static(slots[0..<16], control[0..<queue_words], 0).is_none(),
           "a slot of no bytes has no capacity to compute")

// -- Semaphores and mutexes ---------------------------------------------------------------------

@test
a_binary_semaphore_starts_empty() =
    // The kernel's own convention and the one people get wrong: `xSemaphoreCreateBinary` does *not*
    // hand back something already available, so a task that takes before anybody gives will wait.
    val s = binary_semaphore().expect("a binary semaphore fits in the test heap")

    assert(s.count == 0, "nothing has been given")
    assert(!s.take(0), "so taking one finds nothing")

    s.delete()

@test
a_binary_semaphore_holds_one_and_only_one() =
    val s = binary_semaphore().expect("a binary semaphore fits in the test heap")

    assert(s.give(), "the first give succeeds")
    assert(s.count == 1, "and it is available")
    assert(!s.give(), "the second has nowhere to go — this is what makes it binary")
    assert(s.count == 1, "and did not raise the count")

    assert(s.take(0), "taking finds the one")
    assert(!s.take(0), "and there is not a second")

    s.delete()

@test
a_counting_semaphore_counts() =
    val s = counting_semaphore(3, 0).expect("a counting semaphore fits in the test heap")

    assert(s.count == 0, "it started at zero, as asked")

    s.give()
    s.give()
    assert(s.count == 2, "two gives is two")
    assert(s.give(), "and the third fits")
    assert(!s.give(), "but the fourth is past the maximum")
    assert(s.count == 3, "which is where it stops")

    assert(s.take(0), "and they come back out")
    assert(s.count == 2, "one at a time")

    s.delete()

@test
a_counting_semaphore_can_start_full() =
    // The pool-of-n shape, as against the count-of-events shape above. Both are the same object and the
    // difference is the initial count, which is the argument this checks reached the right parameter.
    val s = counting_semaphore(3, 3).expect("a counting semaphore fits in the test heap")

    assert(s.count == 3, "all three are there to be taken")
    assert(s.take(0) && s.take(0) && s.take(0), "and all three can be")
    assert(!s.take(0), "and then there are none")

    s.delete()

@test
a_counting_semaphore_will_not_start_above_its_maximum() =
    assert(counting_semaphore(2, 3).is_none(), "three of a maximum of two is not a state to start in")
    assert(counting_semaphore(0, 0).is_none(), "a semaphore of maximum zero has nothing to hold")

@test
a_mutex_starts_unlocked_and_locks_once() =
    val m = mutex().expect("a mutex fits in the test heap")

    assert(m.lock(0), "an unlocked mutex is there to be taken")
    assert(m.unlock(), "and given back")

    m.delete()

@test
a_recursive_mutex_can_be_locked_twice_by_its_holder() =
    // The reason `RecursiveMutex` is a separate type. The recursion count lives inside
    // `xQueueTakeMutexRecursive`, so a plain take of the same mutex would find it unavailable and wait
    // — against the task that already holds it, which is a deadlock the types here make unwriteable.
    val m = recursive_mutex().expect("a recursive mutex fits in the test heap")

    assert(m.lock(0), "taken once")
    assert(m.lock(0), "and again by the same holder")
    assert(m.unlock(), "given back once")
    assert(m.unlock(), "and again, which is when it is actually free")

    m.delete()

@test
a_semaphore_can_be_made_from_storage_the_caller_owns() =
    var control: [semaphore_words]usize = [0; semaphore_words]

    val s = binary_semaphore_static(control[0..<semaphore_words]).expect("semaphore_words words is a semaphore's control block")

    assert(s.count == 0, "which starts empty exactly as the heap-allocated one does")
    assert(s.give() && s.take(0), "and works")

    s.delete()

@test
a_mutex_can_be_made_from_storage_the_caller_owns() =
    var control: [semaphore_words]usize = [0; semaphore_words]

    val m = mutex_static(control[0..<semaphore_words]).expect("semaphore_words words is a mutex's control block")

    assert(m.lock(0) && m.unlock(), "and it locks")

    m.delete()

@test
storage_too_small_for_a_semaphore_is_refused() =
    var control: [1]usize = [0; 1]

    assert(binary_semaphore_static(control[0..<1]).is_none(), "one word is not a control block")
    assert(mutex_static(control[0..<1]).is_none(), "nor is it a mutex's")
    assert(counting_semaphore_static(2, 0, control[0..<1]).is_none(), "nor a counting semaphore's")
    assert(recursive_mutex_static(control[0..<1]).is_none(), "nor a recursive mutex's")

// -- Tasks --------------------------------------------------------------------------------------

@test
a_created_task_reports_its_priority_and_is_the_current_one() =
    // Everything here happens before the scheduler runs, which is exactly when a real program creates
    // its tasks.
    //
    // **`Running` is the answer, and it surprised this file's author.** `eTaskGetState` reports
    // `eRunning` for whichever task is `pxCurrentTCB`, and `prvAddNewTaskToReadyList` sets that to the
    // first task created -- before any scheduler exists to run it. So `Running` here means *this is the
    // task the scheduler would resume first*, not that any of its code has executed: nothing has. A
    // second task created at a priority no higher answers `Ready`, which is what the suspension test
    // relies on.
    val t = task("probe", min_stack, 2, &idle_body, null).expect("one minimal task fits in the test heap")

    assert(t.priority == 2, "the priority it was created with")
    assert(t.base_priority == 2, "which is also its base, holding no mutex")
    assert(t.state == Running, "and being the first task created, it is the one pxCurrentTCB names")

    val second = task("second", min_stack, 1, &idle_body, null).expect("two minimal tasks fit in the test heap")

    assert(second.state == Ready, "while a later, no-higher-priority task is merely ready")

    second.delete()
    t.delete()
end a_created_task_reports_its_priority_and_is_the_current_one

@test
a_task_s_priority_can_be_changed() =
    val t = task("probe", min_stack, 2, &idle_body, null).expect("one minimal task fits in the test heap")

    t.set_priority(4)
    assert(t.priority == 4, "the scheduler's figure moved")
    assert(t.base_priority == 4, "and so did its base, since nothing raised it")

    t.delete()

@test
a_suspended_task_says_so() =
    // **Two tasks, and not by accident.** Before the scheduler runs, `pxCurrentTCB` points at a created
    // task, and `vTaskSuspend` sets it to `NULL` when every task there is has been suspended --
    // whereupon `vTaskResume` dereferences it unconditionally, inside
    // `taskYIELD_ANY_CORE_IF_USING_PREEMPTION`, and the process wedges in `vTaskResume` burning a core.
    // That is the kernel's own state machine rather than anything this binding does, and the way to
    // stay out of it is to leave a task unsuspended.
    //
    // The anchor's priority is not lower than the suspended task's for the same reason: resuming a task
    // of higher priority than the current one yields, and there is no scheduler to yield to.
    val anchor = task("anchor", min_stack, 2, &idle_body, null).expect("two minimal tasks fit in the test heap")
    val t = task("probe", min_stack, 1, &idle_body, null).expect("two minimal tasks fit in the test heap")

    t.suspend()
    assert(t.state == Suspended, "suspension is visible")
    t.resume()
    assert(t.state == Ready, "and undone")

    t.delete()
    anchor.delete()

@test
a_task_that_never_ran_has_used_none_of_its_stack() =
    // The high-water mark is measured from the fill pattern the kernel writes at creation, so a task
    // that has not been scheduled should report nearly all of its stack untouched. What this really
    // pins is that the number is a *word count from the far end* rather than bytes used, which is the
    // easy thing to get backwards.
    val t = task("probe", min_stack, 1, &idle_body, null).expect("one minimal task fits in the test heap")

    assert(t.stack_high_water > 0, "an unrun task has never come close to its limit")

    t.delete()

@test
a_stack_depth_that_would_not_fit_the_config_s_type_is_refused() =
    // `configSTACK_DEPTH_TYPE` defaults to `uint16_t`, so a depth of 100,000 becomes 34,464 if it is
    // simply passed on -- a task with a third of the stack it asked for, which runs and then overflows
    // somewhere unrelated. Refusing is the only answer that reaches the caller.
    if stack_depth_max < 18446744073709551615 then
        assert(task("probe", stack_depth_max + 1, 1, &idle_body, null).is_none(),
               "a depth the kernel's own type cannot carry is refused rather than truncated")

@test
a_task_can_be_made_from_storage_the_caller_owns() =
    // The no-heap path, and the one `c const` was needed for: `task_words` is a number only the
    // kernel's headers know, and an array's length must be a constant.
    val t = task_static("static", static_stack[0..<512], static_tcb[0..<task_words], 1,
                        &idle_body, null).expect("512 words and a control block is a task")

    assert(t.state == Running, "a statically created task joins the scheduler's lists like any other")
    assert(t.priority == 1, "with the priority it was given")

    t.delete()

@test
static_task_storage_too_small_for_a_control_block_is_refused() =
    assert(task_static("static", static_stack[0..<512], static_tcb[0..<1], 1, &idle_body,
                       null).is_none(),
           "one word is not a control block, and handing it over would have the kernel write past it")

@test
a_notification_raises_the_target_s_value() =
    // The notification lives in the task's own control block, so this works with no scheduler: the
    // give is a write to that block and only the *wait* would need a context switch. `notify_give` is
    // `eIncrement`, which is the discriminator a macro was hiding.
    val t = task("probe", min_stack, 1, &idle_body, null).expect("one minimal task fits in the test heap")

    assert(t.notify_give(), "notifying a task that is not waiting still succeeds")
    assert(t.notify_give(), "and again — there is no queue to fill")
    assert(t.notify_set_bits(0x0F), "and the bit-field form is the same mechanism")

    t.delete()

@test
the_heap_reports_a_low_water_mark_no_higher_than_what_is_free() =
    // Both of these read the kernel's heap, which -- because this package names `pvPortMalloc` as the
    // program's allocator -- is the heap every sysl allocation comes from too. So this is a claim about
    // the whole program, and the ordering is the only thing that can be checked without knowing what
    // else has run.
    assert(minimum_ever_free_heap() <= free_heap(),
           "the least there has ever been is not more than there is now")

// -- Software timers ------------------------------------------------------------------------------
//
// A timer's *callback* is the one thing here that genuinely needs the scheduler, because the daemon
// runs it. What does not need the scheduler is everything else: creation reads the config and fills a
// control block, the getters read that block, and a command is a queue send. So the tests below cover
// the binding -- symbols, argument order, the command discriminators a macro was hiding -- and the
// last one covers the part that looks unreachable, by finding a kernel function that calls a callback
// synchronously.

@test
a_created_timer_reports_what_it_was_created_with() =
    val t = timer("probe", 100, true, null, &probe_tick).expect("one timer fits in the test heap")

    assert(t.period == 100, "the period it was created with, in ticks")
    assert(t.auto_reload, "and it repeats, because that is what was asked for")
    assert(!t.is_active, "but nothing is running: a new timer is dormant until it is started")
    assert(t.id == null, "and its id is the one handed over, which here is none")

    t.delete(0)

@test
a_timer_s_id_and_reload_mode_can_be_changed() =
    // The id is how one callback serves several timers, so a binding that dropped it -- or that read
    // it back from somewhere other than where it was written -- would make that pattern silently
    // useless rather than fail.
    val t = timer("probe", 100, false, null, &probe_tick).expect("one timer fits in the test heap")

    assert(!t.auto_reload, "created as a one-shot")

    t.set_auto_reload(true)
    assert(t.auto_reload, "and changed into a repeating one")

    t.set_id(marker_ptr())
    assert(t.id == marker_ptr(), "the id read back is the one written")

    t.delete(0)

@test
a_command_is_queued_for_the_daemon_rather_than_acted_on() =
    // **A command is a message, and this is the test that says so.** Every one of these is accepted --
    // they differ only in the discriminator a macro was hiding, which is what is being checked -- and
    // not one of them has done anything, because the daemon that acts on them has never run.
    //
    // That is the single most surprising thing about FreeRTOS timers and the reason `start` is
    // documented as *queued* rather than *started*. A program that starts a timer and immediately
    // tests `is_active` gets `false` on a real board too, if the daemon has not been scheduled yet.
    val t = timer("probe", 100, true, null, &probe_tick).expect("one timer fits in the test heap")

    assert(t.start(0), "a start is accepted")
    assert(t.stop(0), "so is a stop")
    assert(t.reset(0), "and a reset")
    assert(t.set_period(200, 0), "and a change of period, which carries a value as well as a command")

    assert(!t.is_active, "and nothing has happened: four commands are queued and the daemon has not run")
    assert(t.period == 100, "not even the period, which is still the one it was created with")

    t.delete(0)

@test
the_daemon_is_a_task_like_any_other_once_it_exists() =
    // `vTaskStartScheduler` is what creates the daemon in a real program. Creating it directly is what
    // lets this be checked without a scheduler, and is why the package keeps that name private.
    //
    // **This does not check that `timer_daemon` answers `None` beforehand, deliberately**, even though
    // the handle is genuinely NULL until now: `xTimerGetTimerDaemonTaskHandle` puts a `configASSERT`
    // on it, so on this config -- where `configASSERT` is libc's `assert` -- asking early aborts the
    // process rather than returning. The `Option` is for a build with asserts compiled out, which is
    // most release builds, and `timer_daemon`'s documentation says so.
    assert(c_timer_create_daemon() == pass, "the daemon task is created")

    val d = timer_daemon().expect("and now there is one")

    assert(d.priority == timer_task_priority, "at configTIMER_TASK_PRIORITY, which is the knob to turn")

@test
a_timer_can_be_made_from_storage_the_caller_owns() =
    val made = timer_static("static", 100, false, null, &probe_tick,
                            static_timer_control[0..<timer_words])
    val t = made.expect("storage of exactly timer_words words is what the kernel asked for")

    assert(t.period == 100, "a statically created timer is a timer like any other")
    assert(!t.auto_reload, "one-shot, as asked")

    t.delete(0)

@test
static_timer_storage_too_small_for_a_control_block_is_refused() =
    // Refused here rather than passed on, for the reason every `_static` in this package refuses:
    // the kernel would take the pointer and write a whole control block through it.
    assert(timer_static("small", 100, false, null, &probe_tick,
                        static_timer_control[0..<1]).is_none(),
           "one word is not a control block")

@test
the_command_queue_is_finite_and_says_so_when_it_is_full() =
    // The other half of *a command is a message*: the daemon's queue is `configTIMER_QUEUE_LENGTH`
    // entries and a command that will not fit is refused. This is what a `false` from `start` means
    // when the arguments were good, and without a name for the length it is unattributable.
    //
    // **This test deliberately leaves the queue full**, because nothing drains it without a running
    // daemon -- so it is the last one here that issues a command, and no test after it may expect one
    // to succeed.
    val t = timer("probe", 100, true, null, &probe_tick).expect("one timer fits in the test heap")

    var accepted: usize = 0

    for i in 0..<(timer_queue_length + 8)
        if t.start(0) then accepted += 1

    assert(accepted <= timer_queue_length, "the queue never took more than it has room for")
    assert(accepted > 0, "and it did take some, so this measured a full queue rather than a broken one")

// -- Event groups ---------------------------------------------------------------------------------
//
// Every one of these runs with no scheduler because a wait of `0` is a test-and-clear over the
// kernel's own word, and setting bits with nobody blocked walks an empty waiting list.

@test
a_new_event_group_has_no_bits_set() =
    val e = events().expect("an event group fits in the test heap")

    assert(e.bits == 0, "nothing has happened yet")
    assert(event_bits >= 8, "and there is a usable width to set bits in")

    e.delete()

@test
a_bit_set_stays_set_and_setting_it_twice_is_the_same_as_once() =
    // The property that separates an event group from a queue, and the reason to pick between them:
    // a bit is a fact rather than a message, so it does not accumulate.
    val e = events().expect("an event group fits in the test heap")

    assert(e.set(0x01) == 0x01, "setting answers the value afterwards")
    assert(e.set(0x01) == 0x01, "and setting the same bit again changes nothing")
    assert(e.set(0x02) == 0x03, "a second bit joins the first")
    assert(e.bits == 0x03, "which is what the group holds")

    e.delete()

@test
clearing_answers_the_value_from_before_it_cleared() =
    // The opposite convention to `set`, and the kernel's own. A binding that normalised the two would
    // be tidier and would throw away the value a caller needs -- what was taken, rather than what is
    // left.
    val e = events().expect("an event group fits in the test heap")

    e.set(0x0F)

    assert(e.clear(0x03) == 0x0F, "clear answers what was there before")
    assert(e.bits == 0x0C, "and what is left is the rest")

    e.delete()

@test
waiting_for_bits_that_are_already_set_does_not_block() =
    val e = events().expect("an event group fits in the test heap")

    e.set(0x05)

    assert(e.wait(0x05, false, true, 0) == 0x05, "both bits are there, so waiting for all of them returns")
    assert(e.bits == 0x05, "and without clear_on_exit they stay set")

    e.delete()

@test
waiting_with_clear_on_exit_takes_exactly_the_bits_waited_for() =
    // Atomically with the wait ending, which is what makes wait-and-consume free of a race. Here the
    // check is narrower and still worth having: the *other* bits are untouched, so a binding that
    // passed the whole word as the clear mask would be caught.
    val e = events().expect("an event group fits in the test heap")

    e.set(0x07)

    assert(e.wait(0x01, true, false, 0) == 0x07, "the answer is the value at the moment the wait ended")
    assert(e.bits == 0x06, "and only the bit waited for was taken")

    e.delete()

@test
any_and_all_are_different_questions() =
    // `xWaitForAllBits` is the third argument and a binding that swapped it with `xClearOnExit` would
    // pass every test above. This is the one that separates them.
    val e = events().expect("an event group fits in the test heap")

    e.set(0x01)

    assert(e.wait(0x03, false, false, 0) == 0x01, "any of the two is satisfied by the one that is set")
    assert(e.wait(0x03, false, true, 0) == 0x01,
           "all of them is not, so this timed out and still answers the value")
    assert(e.bits == 0x01, "a timed-out wait clears nothing, whatever clear_on_exit said")

    e.delete()

@test
a_sync_that_nobody_else_joins_times_out_with_its_own_bit_set() =
    // The rendezvous, run one-sided because a second participant needs a scheduler. What it does check
    // is that the bits are in the right two arguments: the set happens, the wait is not satisfied, and
    // the kernel leaves the caller's own bit behind for the others to find.
    val e = events().expect("an event group fits in the test heap")

    assert(e.sync(0x01, 0x03, 0) == 0x01, "mine is set, theirs is not, so the barrier was not met")
    assert(e.bits == 0x01, "and mine is still there for them to arrive at")

    e.delete()

@test
an_event_group_can_be_made_from_storage_the_caller_owns() =
    val made = events_static(static_event_control[0..<event_words])
    val e = made.expect("storage of exactly event_words words is what the kernel asked for")

    assert(e.set(0x01) == 0x01, "a statically created group is a group like any other")

    e.delete()

@test
static_event_group_storage_too_small_is_refused() =
    assert(events_static(static_event_control[0..<1]).is_none(),
           "one word is not an event group, and handing it over would have the kernel write past it")

// -- Stream and message buffers -------------------------------------------------------------------
//
// These need no scheduler for the same reason a queue does not: a send with room and a receive with
// bytes waiting both complete without blocking, and only the *waiting* would need a context switch.

@test
a_stream_takes_bytes_and_gives_them_back_in_order() =
    val s = stream(16, 1).expect("a sixteen-byte stream fits in the test heap")

    assert(s.is_empty, "a new stream holds nothing")
    assert(s.spaces == 16, "and all of it is free")

    assert(s.send("hello".bytes, 0) == 5, "five bytes go in")
    assert(s.available == 5, "and five are waiting")

    var got: [8]u8 = [0; 8]

    assert(s.receive(got[0..<8], 0) == 5, "asking for eight gets the five there are")
    assert(got[0] == u8('h') && got[4] == u8('o'), "which are the bytes that went in, in order")
    assert(s.is_empty, "and the stream is empty again")

    s.delete()

@test
a_stream_keeps_no_boundaries_between_sends() =
    // The property that decides between the two types. Two sends read back as one run of bytes, which
    // is right for a UART and wrong for anything with records in it.
    val s = stream(16, 1).expect("a sixteen-byte stream fits in the test heap")

    s.send("abc".bytes, 0)
    s.send("de".bytes, 0)

    var got: [8]u8 = [0; 8]

    assert(s.receive(got[0..<8], 0) == 5, "one receive gets both sends")
    assert(got[2] == u8('c') && got[3] == u8('d'), "run together with nothing between them")

    s.delete()

@test
a_full_stream_takes_what_fits_and_says_how_much() =
    // A short count is the normal answer rather than an error, and it is the whole reason `send`
    // answers a number. A binding returning a bool here would throw away which bytes still have to go.
    val s = stream(4, 1).expect("a four-byte stream fits in the test heap")

    assert(s.send("abcdefgh".bytes, 0) == 4, "four of the eight fit")
    assert(s.is_full, "and now it is full")
    assert(s.send("i".bytes, 0) == 0, "so nothing more goes in without waiting")

    s.delete()

@test
sending_or_receiving_nothing_is_refused_before_it_reaches_the_kernel() =
    // An empty slice's pointer is null, and the kernel copies with `memcpy` -- for which a null source
    // is undefined behaviour even at a length of zero. Cheaper to answer here than to reason about.
    val s = stream(8, 1).expect("an eight-byte stream fits in the test heap")

    var none: [1]u8 = [0; 1]

    assert(s.send(none[0..<0], 0) == 0, "sending no bytes writes none")
    assert(s.receive(none[0..<0], 0) == 0, "and receiving into nowhere reads none")
    assert(s.is_empty, "with the buffer untouched either way")

    s.delete()

@test
a_message_buffer_keeps_the_boundaries_a_stream_does_not() =
    val m = messages(64).expect("a sixty-four-byte message buffer fits in the test heap")

    assert(m.send("abc".bytes, 0), "one message")
    assert(m.send("de".bytes, 0), "and another")

    var got: [8]u8 = [0; 8]

    assert(m.receive(got[0..<8], 0) == 3, "the first receive gets the first message and stops")
    assert(got[0] == u8('a') && got[2] == u8('c'), "all of it")
    assert(m.receive(got[0..<8], 0) == 2, "and the second gets the second")

    m.delete()

@test
a_message_is_all_or_nothing() =
    // The other half of the same distinction: a `Stream` would have taken the front of this and said
    // so, and a partial message is not a thing a reader could do anything with.
    val m = messages(8 + message_overhead).expect("a small message buffer fits in the test heap")

    assert(m.send("abcdefgh".bytes, 0), "a message that exactly fits goes")
    assert(!m.send("x".bytes, 0), "and the next does not, because there is no room for its length too")
    assert(m.next_length == 8, "the one that went is still whole")

    m.delete()

@test
the_length_of_the_next_message_is_readable_before_it_is_taken() =
    // The only way to tell a timeout from a message that would not fit, since `receive` answers zero
    // for both -- which is the sharp edge `Messages.receive` documents.
    val m = messages(64).expect("a sixty-four-byte message buffer fits in the test heap")

    assert(m.next_length == 0, "nothing waiting")

    m.send("abcde".bytes, 0)
    assert(m.next_length == 5, "and now a five-byte message is")

    var small: [2]u8 = [0; 2]

    assert(m.receive(small[0..<2], 0) == 0, "which will not fit in two bytes, so nothing is read")
    assert(m.next_length == 5, "and it is still there, rather than lost to a receive that failed")

    m.delete()

@test
a_stream_s_trigger_level_is_bounded_by_its_capacity() =
    val s = stream(8, 1).expect("an eight-byte stream fits in the test heap")

    assert(s.set_trigger_level(4), "a level within the capacity is accepted")
    assert(!s.set_trigger_level(9), "one above it could never be reached, so the kernel refuses it")

    s.delete()

@test
a_stream_that_could_never_be_read_is_refused_at_creation() =
    // Refused here rather than passed on, because the kernel's own answer to a trigger level above the
    // capacity at *creation* is a `configASSERT` rather than a null.
    assert(stream(0, 1).is_none(), "a stream of no bytes holds nothing")
    assert(stream(8, 0).is_none(), "a trigger of none is not a level the kernel accepts")
    assert(stream(8, 9).is_none(), "and one above the capacity could never be reached")
    assert(messages(0).is_none(), "a message buffer of no bytes holds no message")

@test
a_stream_can_be_made_from_storage_the_caller_owns() =
    // And the usable capacity is one byte less than the storage, which the dynamic path hides by
    // allocating one more than asked for. Pinned here because it is the one number a caller at the
    // boundary would otherwise get wrong.
    val made = stream_static(static_stream_storage[0..<16], static_stream_control[0..<stream_words], 1)
    val s = made.expect("sixteen bytes and a control block is what the kernel asked for")

    assert(s.spaces == 15, "one byte of the sixteen is the kernel's, to tell full from empty")
    assert(s.send("hello".bytes, 0) == 5, "and the rest is a stream like any other")

    s.delete()

@test
static_stream_storage_too_small_is_refused() =
    assert(stream_static(static_stream_storage[0..<1], static_stream_control[0..<stream_words], 1)
               .is_none(),
           "one byte is all header and no capacity")

    assert(stream_static(static_stream_storage[0..<16], static_stream_control[0..<1], 1).is_none(),
           "and one word is not a control block")

@test
the_kernel_calls_a_sysl_callback_with_the_handle_it_was_asked_about() =
    // **This is the test the timer callback's shape rests on**, and it exists because the obvious way
    // to check a callback -- let a timer expire -- needs the scheduler this file will not start.
    //
    // A callback is the one place in this package where **C calls sysl** rather than the other way
    // round, and nothing else here would notice if that direction were wrong: a timer would be created
    // happily and its callback handed rubbish on a real board, months later.
    //
    // `uxTaskCallForEachTask` settles it without a scheduler, because it calls its callback
    // synchronously for every task from the caller's own context -- and it hands over a `TaskHandle_t`
    // first and an opaque context pointer third, which is the shape a timer callback is in. A handle
    // arriving intact here is the proof, and the context pointer covers the argument beside it.
    //
    // What is *not* in question, because the compiler refuses it outright, is passing the handle as a
    // `Timer`: a sysl function with an aggregate parameter has no address C can call, and taking one
    // is an error rather than a miscompile. That refusal is why `timer_of` exists.
    val t = task("probe", min_stack, 1, &idle_body, null).expect("one minimal task fits in the test heap")

    probe_expected = t.handle
    probe_found = false
    probe_context_ok = false
    probe_seen = 0

    var run_time: u32 = 0
    val visited = c_for_each_task(&probe_visit, marker_ptr(), &run_time)

    assert(visited > 0, "the kernel knows about at least the task just created")
    assert(probe_seen == visited, "and the callback ran once for each of them")
    assert(probe_found, "the handle the callback received is the one the kernel was asked about")
    assert(probe_context_ok, "and the context pointer arrived beside it, unchanged")

    t.delete()

// What the callback above records, and what it is called with. Module storage because a callback has
// no captures -- which is the same constraint a task body is under, and the reason a timer carries an
// id at all.
private var probe_marker: u32 = 0

// The marker's address as the untyped pointer both a timer id and a callback context are, said once
// because `ptr_cast` takes its target type from where the result is read into and a comparison says
// nothing about that.
private marker_ptr() -> *u8 = ptr_cast(&probe_marker)
private var probe_expected: *TaskControlBlock = ptr_cast(0usize)
private var probe_found: bool = false
private var probe_context_ok: bool = false
private var probe_seen: usize = 0

// `eTaskState` is spelled `i32` rather than bound to this package's `TaskState`, deliberately: a C
// enum's width is the C toolchain's business -- `-fshort-enums` makes it a byte on some ARM builds --
// and nothing here needs the value. What is being checked is the first argument and the third.
private probe_visit(handle: *TaskControlBlock, state: i32, context: *u8)
    probe_seen += 1

    if handle == probe_expected then
        probe_found = true
        probe_context_ok = context == marker_ptr()

// Test-only, and not part of the package's surface: it needs `configUSE_TRACE_FACILITY 1` and it hands
// out every task in the system, which is a debugging facility rather than something a program builds
// on. It is here because it is the one exported kernel function that calls a caller-supplied pointer
// with no scheduler running.
private extern "uxTaskCallForEachTask" c_for_each_task(
    visit: *extern(*TaskControlBlock, i32, *u8) -> unit, context: *u8, run_time: *u32) -> usize

// A statically created timer's and event group's control blocks, module storage for the same reason a
// task's stack is.
private var static_timer_control: [timer_words]usize = [0; timer_words]
private var static_event_control: [event_words]usize = [0; event_words]
private var static_stream_control: [stream_words]usize = [0; stream_words]
private var static_stream_storage: [16]u8 = [0; 16]

// A callback for the tests above. It never runs -- nothing here lets the daemon execute -- so what it
// does is irrelevant; what matters is that it is a shape `xTimerCreate` will accept.
private probe_tick(handle: *TimerControl) = probe_seen += 1

// A struct the size of a queue slot, for the copying test above. Two fields rather than one so that a
// binding that copied only the first would be caught.
private struct Reading
    channel: u32
    value: u32

// A statically created task's storage has to outlive the task, so it is module storage rather than a
// local -- which is the constraint `task_static`'s documentation is about, shown here rather than only
// described. Two tests share it, and neither leaves a task alive.
private var static_stack: [512]usize = [0; 512]
private var static_tcb: [task_words]usize = [0; task_words]

// -- Why there is nothing of the application's in this file ---------------------------------------
//
// A FreeRTOS kernel demands things of whoever links it: a `configASSERT` handler, and -- under
// `configSUPPORT_STATIC_ALLOCATION` -- the idle and timer tasks' storage through
// `vApplicationGetIdleTaskMemory` and `vApplicationGetTimerTaskMemory`. The test binary is an
// application, so without them the suite does not link, naming `_vAssertCalled` referenced from
// `pvPortMalloc` and saying nothing about what wanted it.
//
// **They are answered by `test-config/FreeRTOSConfig.h` rather than written here, and that is not
// tidiness.** An `@export` is one definition of one symbol, and the check is made across the whole
// program *before* a `@tests` file is dropped -- so three `@export`s here would collide with the three
// any real application must have, and the diagnostic would name this package as the other definition.
// Measured, not assumed: it is what stopped the README's own example from compiling.
//
// So the config sets `configKERNEL_PROVIDED_STATIC_MEMORY 1`, which has the kernel define its own
// static storage, and spells `configASSERT` through libc's `assert`. Neither needs a symbol from
// anybody. A real application on a real board will want the hooks -- README.md shows them -- and this
// file is the wrong place to demonstrate that, because a demonstration here is a definition
// everywhere.
